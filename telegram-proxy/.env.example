# =============================================================================
# telegram-proxy — образец env-переменных («тупая труба»: только приём/отправка;
# все решения — в основном сервисе, модуль application/telegram)
# railway: эти переменные задаются в ENV Railway-сервиса (см. railway-meetup-tg-proxy)
# локально: бот по умолчанию выключен (TELEGRAM_BOT_ENABLED не задан = false),
# приложение поднимает только Ktor :8082 без Telegram.
# =============================================================================

# --- Ktor ----------------------------------------------------------------------
# Railway подставляет PORT сам; локально дефолт 8082
#PORT=8082

# --- Telegram-бот --------------------------------------------------------------
# ВЫКЛЮЧАТЕЛЬ: дефолт false — тесты/локальный запуск бота НЕ поднимают.
# true только на Railway (или осознанно локально с реальным токеном).
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Авторизация команд отправки POST /api/send (вызывает основной сервис) ------
# Тот же секрет, что proxy.token у meetup-flow-agent (ждёт Bearer {PROXY_TOKEN})
PROXY_TOKEN=change-me-proxy-token

# --- Основной сервис (куда форвардить ВСЕ апдейты) ------------------------------
# Публичный URL meetup-flow-agent и его APP_TOKEN (/api ждёт RAW-заголовок)
MEETUP_FLOW_URL=http://localhost:8090
MEETUP_FLOW_TOKEN=change-me-app-token
