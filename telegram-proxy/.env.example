# =============================================================================
# telegram-proxy — образец env-переменных
# railway: эти переменные задаются в ENV Railway-сервиса (см. railway-meetup-tg-proxy)
# локально: cp .env.example .env — но бот по умолчанию выключен (TELEGRAM_BOT_ENABLED
# не задан = false), приложение поднимает только Ktor :8082 без Telegram.
# =============================================================================

# --- Ktor ----------------------------------------------------------------------
# Railway подставляет PORT сам; локально дефолт 8082
#PORT=8082

# --- Telegram-бот --------------------------------------------------------------
# ВЫКЛЮЧАТЕЛЬ: дефолт false — тесты/локальный запуск бота НЕ поднимают.
# true только на Railway (или осознанно локально с реальным токеном).
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Общий канал/группа анонсов (EVENT_PUBLISHED; fallback при пустых userIds)
TELEGRAM_MAIN_CHAT_ID=

# Источник сырого passthrough: флоу извлечения создают ТОЛЬКО сообщения из
# этой группы и этого топика (message_thread_id; форум-группа, General = 1).
# Прочие чаты (лички, сторонние группы) игнорируются.
# Любая из переменных пуста → по ней ограничений нет; обе пустые → фильтр выключен.
TELEGRAM_SOURCE_CHAT_ID=
TELEGRAM_SOURCE_TOPIC_ID=

# --- Авторизация входящих POST /api/notify --------------------------------------
# Тот же секрет, что proxy.token у meetup-flow-agent (ждёт Bearer {PROXY_TOKEN})
PROXY_TOKEN=change-me-proxy-token

# --- meetup-flow-agent ----------------------------------------------------------
# Публичный URL основного сервиса и его APP_TOKEN (/api/messages ждёт RAW-заголовок)
MEETUP_FLOW_URL=http://localhost:8090
MEETUP_FLOW_TOKEN=change-me-app-token

# --- HITL (можно не задавать) ----------------------------------------------------
# TTL заданных вопросов (снятие неактуальных кнопок), часов
HITL_PENDING_TTL_HOURS=24
