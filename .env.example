# =============================================================================
# meetup-flow-agent — образец env-переменных
# Скопируй в .env и заполни реальными значениями:  cp .env.example .env
# .env подключается к docker-compose (env_file) и к приложению
# (env-плейсхолдеры ${VAR:default} в config.properties). Не коммитится (.gitignore).
# Переменные с дефолтами можно не задавать — значения ниже показывают дефолты.
# =============================================================================

# --- Приложение ---------------------------------------------------------------
# Bearer-токен авторизации всего /api (входящие запросы прокси/фронта, включая SSE)
APP_TOKEN=change-me-app-token
# Разрешённые CORS-origins, через запятую (пусто = CORS фактически выключен)
CORS_ALLOWED_ORIGINS=

# --- Postgres 18 + pgvector (docker-compose и приложение) ---------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meetup_flow_agent
DB_USER=meetup
DB_PASSWORD=change-me-db-password

# --- LLM: Z.AI (OpenAI-compatible) --------------------------------------------
# ВАЖНО: base URL зависит от типа аккаунта:
#   GLM Coding Plan (подписка)  → https://api.z.ai/api/coding/paas/v4
#   Developer API (pay-as-you-go) → https://api.z.ai/api/paas/v4 (нужен баланс)
# glm-5.3 (guardrails) и glm-5.3-flash (агент) — один ключ на обе
LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
LLM_API_KEY=

# --- Эмбеддинги: Yandex AI Studio (OpenAI-compatible) -------------------------
# API-ключ сервис-аккаунта Yandex Cloud с ролью ai.languageModels.user
EMBEDDING_BASE_URL=https://ai.api.cloud.yandex.net/v1
EMBEDDING_API_KEY=
# ID каталога сервис-аккаунта AI Studio (НЕ дефолтный каталог облака — при несовпадении API вернёт 400);
# входит в model URI emb://<folderId>/text-embeddings-v2-doc/latest
EMBEDDING_FOLDER_ID=

# --- Прокси-проект (Telegram) -------------------------------------------------
# Base URL самописного прокси; мы вызываем POST {PROXY_BASE_URL}/api/notify
PROXY_BASE_URL=
# Bearer-токен для исходящих вызовов прокси
PROXY_TOKEN=

# --- Observability (OpenTelemetry → Jaeger) -----------------------------------
# Экспортер трейсов; пусто/OTEL_ENABLED=false — трейсинг выключен
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_ENABLED=true

# --- Шедулеры (kill-switch; можно не задавать) --------------------------------
# Поллер inbox: false = полная остановка обработки сообщений (inbox копится)
SCHEDULER_INBOX_ENABLED=true
SCHEDULER_RETRY_ENABLED=true
SCHEDULER_HUMAN_TIMEOUT_ENABLED=true
