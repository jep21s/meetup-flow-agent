{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Meetup event contract",
  "description": "Контракт итогового JSON агента meetup-flow-agent (§7 COMMON_PLAN.md)",
  "type": "object",
  "required": ["title", "verdict"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "organizer": { "type": ["string", "null"] },
    "city": { "type": ["string", "null"] },
    "isFree": { "type": ["boolean", "null"] },
    "price": { "type": ["string", "null"] },
    "formats": {
      "type": "array",
      "items": { "type": "string", "enum": ["OFFLINE", "ONLINE"] }
    },
    "address": { "type": ["string", "null"] },
    "venueName": { "type": ["string", "null"] },
    "startsAt": { "type": ["string", "null"], "description": "ISO-8601 с таймзоной, например 2026-09-20T19:00+03:00" },
    "endsAt": { "type": ["string", "null"] },
    "talks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": ["string", "null"] },
          "speaker": { "type": ["string", "null"] },
          "description": { "type": ["string", "null"] }
        }
      }
    },
    "registrationUrl": { "type": ["string", "null"] },
    "registrationNotRequired": { "type": ["boolean", "null"] },
    "sourceUrls": { "type": "array", "items": { "type": "string" } },
    "language": { "type": ["string", "null"] },
    "verdict": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["APPROVED", "REJECTED", "NEEDS_REVIEW"] },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
  }
}
